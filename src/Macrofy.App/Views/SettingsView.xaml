<UserControl x:Class="Macrofy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Macrofy.App">
    <UserControl.Resources>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14" />
            <Setter Property="Background" Value="{DynamicResource RmCardBorderBrush}" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="4,22,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.Enabled="True">
        <StackPanel Margin="28,22,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="How Macrofy looks, starts up, and behaves." />

            <!-- GENERAL -->
            <TextBlock Text="GENERAL" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Appearance" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Light, dark, or follow your Windows setting." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="170" VerticalAlignment="Center" ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ThemeLabel}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Smooth scrolling" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Eased mouse-wheel scrolling. Turn it off for plain Windows scrolling." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SmoothScrolling, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- STARTUP -->
            <TextBlock Text="STARTUP AND TRAY" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Start Macrofy when you sign in. It comes up quietly in the system tray." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start minimized" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Open in the tray even when you start Macrofy yourself." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Keep running when I close the window" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Closing the window leaves Macrofy in the tray so your macros keep working." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Tray notifications" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Show a short notice when Macrofy hides to the tray." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CAPTURE -->
            <TextBlock Text="CAPTURE" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Capture a keyboard at startup" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Grab this keyboard as soon as Macrofy starts, and again whenever it's plugged back in." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoCaptureOnLaunch, Mode=TwoWay}" />
                    </Grid>
                    <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Keyboards}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding AutoCaptureDevice, Mode=TwoWay}" IsEnabled="{Binding AutoCaptureOnLaunch}" />
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Capture on/off shortcut" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Toggle capture from anywhere. Handy right before you launch a game." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding GlobalHotkeyEnabled, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Shortcut" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <ui:TextBox Width="220" IsReadOnly="True" Cursor="Hand" Text="{Binding GlobalHotkeyDisplay, Mode=OneWay}"
                                    PreviewKeyDown="GlobalHotkeyBox_PreviewKeyDown" IsEnabled="{Binding GlobalHotkeyEnabled}"
                                    ToolTip="Click, then press your shortcut (it must include Ctrl, Alt, Shift or Win)" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource RmWarningBrush}"
                               Text="{Binding GlobalHotkeyProblem}"
                               Visibility="{Binding HasGlobalHotkeyProblem, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Show devices that aren't keyboards" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Some macro pads and receivers don't describe themselves as keyboards. Turn this on if yours is missing." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowAllDevices, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ADMINISTRATOR -->
            <TextBlock Text="ADMINISTRATOR" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Run as administrator" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding ElevationStatus}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Restart as administrator"
                                   Click="RestartAsAdmin_Click" Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Always run as administrator" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Ask for administrator every time Macrofy starts. Expect a Windows prompt on each launch." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AlwaysRunAsAdmin, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- UPDATES -->
            <TextBlock Text="UPDATES" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Macrofy updates" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding UpdateStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Check now" Click="CheckUpdates_Click" IsEnabled="{Binding CanUpdate}"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource InverseBoolToVis}}" />
                            <ui:Button Content="Install and restart" Appearance="Primary" Click="InstallUpdate_Click"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Look for a new version on GitHub when Macrofy starts. Nothing else is sent anywhere." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DATA -->
            <TextBlock Text="YOUR DATA" Style="{StaticResource Group}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Profiles, layouts and settings" Style="{StaticResource SettingTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Text="Everything is stored on this PC, in your AppData folder." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Open folder" Click="OpenDataFolder_Click" />
                        <ui:Button Content="Delete all profiles" Appearance="Danger" Margin="8,0,0,0" Click="DeleteAllProfiles_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
