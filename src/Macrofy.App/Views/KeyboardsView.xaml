<UserControl x:Class="Macrofy.App.Views.KeyboardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Macrofy.App"
             xmlns:vm="clr-namespace:Macrofy.App.ViewModels"
             xmlns:core="clr-namespace:Macrofy.Core.Macros;assembly=Macrofy.Core">
    <UserControl.Resources>

        <!-- One key on the on-screen keyboard. Bound keys show their action's icon and label. -->
        <DataTemplate x:Key="KeyCapTemplate" DataType="{x:Type vm:KeyCapViewModel}">
            <Border Width="{Binding Width}" Height="{Binding Height}" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="KeyCap_Click">
                <Grid x:Name="root" Margin="2.5" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="capScale" />
                    </Grid.RenderTransform>
                    <Border CornerRadius="9" Background="{DynamicResource RmKeyShadowBrush}" Margin="0,2,0,0" />
                    <Border x:Name="cap" CornerRadius="9" Margin="0,0,0,2"
                            Background="{DynamicResource RmKeyBrush}"
                            BorderBrush="{DynamicResource RmKeyBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Border x:Name="tint" CornerRadius="8" Background="{DynamicResource RmAccentMutedBrush}"
                                    Visibility="Collapsed" />
                            <Grid Margin="5,3,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="legend" Grid.Row="0" Text="{Binding Label}" FontSize="10"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ui:SymbolIcon x:Name="boundIcon" Grid.Row="0" Symbol="{Binding BindingIcon}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
                                               Foreground="{DynamicResource RmAccentBrush}"
                                               Visibility="{Binding IsBound, Converter={StaticResource BoolToVis}}" />
                                <TextBlock x:Name="boundLabel" Grid.Row="1" Text="{Binding BindingLabel}" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="11.5" LineStackingStrategy="BlockLineHeight" MaxHeight="23"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsBound, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="ring" CornerRadius="11" Margin="-2.5" BorderThickness="2"
                            BorderBrush="{DynamicResource RmAccentBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                    <Setter TargetName="root" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Capturable}" Value="False">
                    <Setter TargetName="cap" Property="Opacity" Value="0.35" />
                    <Setter TargetName="cap" Property="ToolTip"
                            Value="Windows handles this key before Macrofy sees it, so it can't be a macro." />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBound}" Value="True">
                    <Setter TargetName="tint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInherited}" Value="True">
                    <Setter TargetName="tint" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="boundIcon" Property="Opacity" Value="0.45" />
                    <Setter TargetName="boundLabel" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter TargetName="cap" Property="Background" Value="{DynamicResource RmAccentBrush}" />
                    <Setter TargetName="cap" Property="BorderBrush" Value="{DynamicResource RmAccentBrush}" />
                    <Setter TargetName="legend" Property="Foreground" Value="{DynamicResource RmOnAccentBrush}" />
                    <Setter TargetName="boundIcon" Property="Foreground" Value="{DynamicResource RmOnAccentBrush}" />
                    <Setter TargetName="boundLabel" Property="Foreground" Value="{DynamicResource RmOnAccentBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="capScale" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.05" />
                                <DoubleAnimation Storyboard.TargetName="capScale" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.05" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="capScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="capScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="KeyRowTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource KeyCapTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- A bound key in the "on this layer" list -->
        <DataTemplate x:Key="BoundChipTemplate" DataType="{x:Type core:MacroBinding}">
            <Button Style="{StaticResource PillButton}" Margin="0,0,8,8" Padding="6,5,12,5" Click="BoundChip_Click">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource RmKeyBrush}"
                            BorderBrush="{DynamicResource RmKeyBorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding KeyCode, Converter={StaticResource KeyName}}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ui:SymbolIcon Symbol="{Binding Converter={StaticResource ActionIcon}}" FontSize="14" Margin="8,0,5,0"
                                   Foreground="{DynamicResource RmAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Converter={StaticResource BindingLabel}}" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.Enabled="True">
        <Grid Margin="28,22,28,24" MinHeight="660">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="260" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Which keyboard, its profile, and capture -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DeviceTile" Grid.Column="0" Width="56" Height="56" CornerRadius="16" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource RmIconBgBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RmAccentMutedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KeyboardName}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding KeyboardSubtitle}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SwitchKeyboardButton" Style="{StaticResource PillButton}" Margin="0,0,8,6"
                                AutomationProperties.Name="Switch keyboard"
                                Click="SwitchKeyboard_Click" ToolTip="Choose which keyboard to set up">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Switch keyboard" />
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Margin="6,1,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,8,6" Click="IdentifyKeyboard_Click"
                                AutomationProperties.Name="Pick by pressing a key"
                                ToolTip="Press any key on a keyboard to pick it">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CursorClick24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Pick by pressing a key" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,8,6" Click="RenameKeyboard_Click"
                                AutomationProperties.Name="Rename keyboard"
                                IsEnabled="{Binding HasSelection}" ToolTip="Give this keyboard a name you'll recognise">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Rename" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="PROFILE" Style="{StaticResource SectionLabel}" Margin="4,0,0,7" />
                        <Button x:Name="ProfileButton" Style="{StaticResource PillButton}" MinWidth="180"
                                AutomationProperties.Name="Switch profile"
                                HorizontalContentAlignment="Stretch" Click="ProfileMenu_Click"
                                IsEnabled="{Binding HasSelection}" ToolTip="Switch this keyboard to another profile">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Album24" FontSize="15" Margin="0,0,8,0"
                                               Foreground="{DynamicResource RmAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveProfileName}" FontWeight="SemiBold"
                                           MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronDown24" FontSize="12" Margin="8,1,0,0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CAPTURE" Style="{StaticResource SectionLabel}" Margin="4,0,0,7" />
                        <Border x:Name="CapturePill" CornerRadius="18" Padding="14,3,6,3" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource RmSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource RmCardBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RmAccentMutedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource RmAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CaptureDot" Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource RmAccentBrush}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DotPulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="DotPulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CaptureStateText}" Width="72" Margin="9,0,4,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ui:ToggleSwitch VerticalAlignment="Center" Focusable="False"
                                                 AutomationProperties.Name="Capture"
                                                 IsChecked="{Binding IsCapturing, Mode=TwoWay}"
                                                 IsEnabled="{Binding HasSelection}" RenderTransformOrigin="0.5,0.5">
                                    <ui:ToggleSwitch.RenderTransform>
                                        <TranslateTransform x:Name="CaptureToggleShake" />
                                    </ui:ToggleSwitch.RenderTransform>
                                </ui:ToggleSwitch>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Status + problems -->
            <StackPanel Grid.Row="1" Margin="0,16,0,14">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="13" />
                <Border Margin="0,12,0,0" CornerRadius="12" Padding="14,11"
                        Background="#26E8A317" BorderBrush="#66E8A317" BorderThickness="1"
                        Visibility="{Binding HasHookIssue, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="{DynamicResource RmWarningBrush}"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Text="{Binding HookError}" TextWrapping="Wrap" MaxWidth="820" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- The keyboard -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,18">
                <Grid>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LAYERS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource LayerChipStyle}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         MouseDoubleClick="LayerList_MouseDoubleClick"
                                         ToolTip="Double-click a layer to rename it">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Style="{StaticResource PillButton}" Padding="9,3" Click="AddLayer_Click"
                                        AutomationProperties.Name="Add a layer"
                                        IsEnabled="{Binding HasSelection}" ToolTip="Add a layer">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource PillButton}" Padding="9,3" Margin="6,0,0,0" Click="RemoveLayer_Click"
                                        AutomationProperties.Name="Remove this layer"
                                        IsEnabled="{Binding CanRemoveLayer}" ToolTip="Remove this layer">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                </Button>
                                <Border Margin="12,0,0,0" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                                        Background="{DynamicResource RmAccentMutedBrush}"
                                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource RmAccentBrush}"
                                               Text="{Binding ActiveLayerName, StringFormat='Active now: {0}'}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="160" ItemsSource="{Binding LayoutKinds}" IsEnabled="{Binding HasSelection}"
                                          SelectedItem="{Binding SelectedLayoutKind, Mode=TwoWay}" ToolTip="Which shape to draw">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LayoutKindLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Content="ISO" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="0"
                                          ToolTip="European shape: tall Enter, short left Shift with an extra key beside it"
                                          IsChecked="{Binding IsIsoLayout, Mode=TwoWay}"
                                          Visibility="{Binding ShowIsoToggle, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource PillButton}" Margin="10,0,0,0" Click="LearnKeys_Click"
                                        IsEnabled="{Binding HasSelection}"
                                        ToolTip="Press every key on an unusual keyboard to draw it exactly">
                                    <TextBlock Text="Learn keys…" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Viewbox x:Name="KeyboardBox" Stretch="Uniform" StretchDirection="Both" MaxHeight="400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding KeyboardLayout.Rows}" ItemTemplate="{StaticResource KeyRowTemplate}" />
                            </Viewbox>

                            <!-- Custom layout chosen but nothing learned yet -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowLearnPrompt, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="30" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No keys learned yet" />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                                           Text="Press every key once so the drawing matches this keyboard." />
                                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="Learn keys…" Click="LearnKeys_Click" />
                            </StackPanel>

                            <!-- No keyboard at all -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="34" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                           Text="No keyboards found" />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                                           Text="Plug in the keyboard you want to turn into a macro pad." />
                                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="Look again"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Click="Refresh_Click" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Pick a keyboard by pressing one of its keys -->
                    <Border CornerRadius="12" Background="{DynamicResource RmCardBrush}" Margin="-8"
                            Visibility="{Binding IsIdentifying, Converter={StaticResource BoolToVis}}"
                            local:Anim.FadeInOnVisible="True" Focusable="True" x:Name="IdentifyOverlay">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Border Width="72" Height="72" CornerRadius="22" HorizontalAlignment="Center"
                                    Background="{DynamicResource RmAccentMutedBrush}">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="34" Foreground="{DynamicResource RmAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIdentifying}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="IdentifyPulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.8" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="IdentifyPulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                       Text="Press any key on the keyboard you want" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Muted}"
                                       Text="Macrofy picks whichever keyboard the key came from. Nothing gets typed or blocked." />
                            <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="Cancel" Click="CancelIdentify_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Calibration -->
                    <Border CornerRadius="12" Background="{DynamicResource RmCardBrush}" Margin="-8"
                            Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}"
                            local:Anim.FadeInOnVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="34" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource RmAccentBrush}" />
                            <TextBlock Text="Learning your keyboard" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock TextAlignment="Center" Margin="0,6,0,0" Style="{StaticResource Muted}"
                                       Text="Press every key on this keyboard once. Nothing types or fires macros while you do this." />
                            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RmAccentBrush}"
                                       Text="{Binding LearnedKeys.Count, StringFormat='{}{0} keys recorded'}" />
                            <Border Margin="0,10,0,0" MaxHeight="110" CornerRadius="8"
                                    Background="{DynamicResource RmSubtleBrush}" Padding="8"
                                    Visibility="{Binding LearnedKeys.Count, Converter={StaticResource NonEmptyToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LearnedKeys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,5,5" CornerRadius="5" Padding="7,3"
                                                        Background="{DynamicResource RmAccentMutedBrush}">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource RmAccentBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="Cancel" Click="CancelLearn_Click" MinWidth="96" />
                                <ui:Button Content="Save layout" Appearance="Primary" Click="SaveLearned_Click"
                                           MinWidth="120" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor: what the selected key does -->
            <Border x:Name="EditorCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Nothing selected: what's on this layer -->
                    <StackPanel Visibility="{Binding HasBindKey, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CursorClick24" FontSize="20" Foreground="{DynamicResource RmAccentBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Click a key to give it a macro" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="30,4,0,0"
                                   Text="Or turn capture on and press it on the keyboard. Want a head start? Try a template on the Profiles page." />
                        <TextBlock Margin="0,18,0,10" Style="{StaticResource SectionLabel}" Text="MACROS ON THIS LAYER" />
                        <TextBlock Style="{StaticResource Muted}" Text="Nothing on this layer yet."
                                   Visibility="{Binding Bindings.Count, Converter={StaticResource EmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding Bindings}" ItemTemplate="{StaticResource BoundChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- A key is selected -->
                    <Grid x:Name="EditorContent" Visibility="{Binding HasBindKey, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="9" Padding="12,7" MinWidth="44"
                                        Background="{DynamicResource RmKeyBrush}" BorderBrush="{DynamicResource RmAccentBrush}" BorderThickness="2">
                                    <TextBlock Text="{Binding BindKeyName}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BindKeyName, StringFormat='Key {0}'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="{Binding SelectedLayer.Name, StringFormat='On the {0} layer'}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="WHAT IT DOES" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                            <ListBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ActionCardStyle}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="LABEL ON THE KEY" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <ui:TextBox PlaceholderText="{Binding BindLabelPlaceholder}" MaxLength="24"
                                        Text="{Binding BindLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding BindTargetLabel}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Padding="7,3"
                                        AutomationProperties.Name="Close editor"
                                        Click="CloseEditor_Click" ToolTip="Close">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- Open app / link / command -->
                            <Grid Visibility="{Binding IsStandardTarget, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" PlaceholderText="{Binding BindTargetPlaceholder}"
                                            Text="{Binding BindTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="Browse_Click"
                                           Visibility="{Binding ShowBrowse, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <ui:TextBox Margin="0,8,0,0" PlaceholderText="Arguments (optional)"
                                        Text="{Binding BindArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding ShowArguments, Converter={StaticResource BoolToVis}}" />

                            <!-- Type text -->
                            <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="130"
                                        VerticalScrollBarVisibility="Auto" PlaceholderText="{Binding BindTargetPlaceholder}"
                                        Text="{Binding BindTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsMultilineTarget, Converter={StaticResource BoolToVis}}" />

                            <!-- Shortcut recorder -->
                            <ui:TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                                        PlaceholderText="{Binding BindTargetPlaceholder}"
                                        Text="{Binding BindTarget, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                        Visibility="{Binding IsHotkeyKind, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#FF8A8A"
                                       Text="{Binding HotkeyError}"
                                       Visibility="{Binding HotkeyError, Converter={StaticResource TextToVis}}" />

                            <!-- Media -->
                            <ComboBox ItemsSource="{Binding MediaOptions}" DisplayMemberPath="Label" SelectedValuePath="Token"
                                      SelectedValue="{Binding BindTarget, Mode=TwoWay}"
                                      Visibility="{Binding IsMediaKind, Converter={StaticResource BoolToVis}}" />

                            <!-- Layers -->
                            <ComboBox ItemsSource="{Binding LayerTargets}" SelectedItem="{Binding BindTarget, Mode=TwoWay}"
                                      Visibility="{Binding ShowLayerPicker, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Add another layer first with the + next to the layer names, then pick it here."
                                       Visibility="{Binding ShowAddLayerHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Margin="2,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding BindTargetHelp}" />
                            <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource RmAccentBrush}" Text="{Binding InheritedNote}"
                                       Visibility="{Binding HasInheritedNote, Converter={StaticResource BoolToVis}}" />

                            <!-- Sequence -->
                            <StackPanel Visibility="{Binding IsLayerKind, Converter={StaticResource InverseBoolToVis}}" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding PendingSteps}"
                                              Visibility="{Binding HasPendingSteps, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Padding="10,6" CornerRadius="8" Background="{DynamicResource RmSubtleBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Action, Converter={StaticResource ActionIcon}}"
                                                                   FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource RmAccentBrush}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Action.Description}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Text="{Binding DelayMsAfter, StringFormat='then wait {0} ms'}"
                                                                   Visibility="{Binding DelayMsAfter, Converter={StaticResource NonEmptyToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource PillButton}" Padding="6,2" Click="StepUp_Click" ToolTip="Move up">
                                                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource PillButton}" Padding="6,2" Margin="4,0,0,0" Click="StepDown_Click" ToolTip="Move down">
                                                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource PillButton}" Padding="6,2" Margin="4,0,0,0" Click="StepRemove_Click" ToolTip="Remove step">
                                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Content="Add as a step" Icon="{ui:SymbolIcon Add24}" Click="AddStep_Click"
                                               ToolTip="Save this action as a step and set up the next one" />
                                    <TextBlock Text="then wait" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <ui:TextBox Width="64" Text="{Binding BindDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="ms" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>

                                <CheckBox Margin="0,12,0,0" Content="Repeat while the key is held"
                                          IsChecked="{Binding RepeatWhileHeld, Mode=TwoWay}"
                                          ToolTip="Keep firing as long as the key is held down, like volume keys" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <ui:Button Content="Remove macro" Appearance="Danger" Margin="0,0,8,0" Click="RemoveMacro_Click"
                                           Visibility="{Binding IsExistingBinding, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Content="Save macro" Appearance="Primary" MinWidth="130" Click="SaveMacro_Click"
                                           Icon="{ui:SymbolIcon Checkmark24}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
