<UserControl x:Class="Macrofy.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Macrofy.App">
    <UserControl.Resources>
        <!-- A key on the little diagram -->
        <Style x:Key="DiagramKey" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="Background" Value="{DynamicResource RmKeyBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RmKeyBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Arrow" TargetType="Path">
            <Setter Property="Data" Value="M0,5 L16,5 M11,0.5 L16,5 L11,9.5" />
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <!-- One line of the spec sheet -->
        <Style x:Key="SpecLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,9,16,9" />
        </Style>
        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,9,0,9" />
        </Style>
        <Style x:Key="SpecRule" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource RmCardBorderBrush}" />
        </Style>
        <!-- A text link -->
        <Style x:Key="TextLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource RmAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.Enabled="True">
        <StackPanel Margin="28,26,28,28" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Hero: the logo is a key you can press -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LogoKey" Click="LogoKey_Click" Cursor="Hand" ToolTip="Go on, press it"
                        AutomationProperties.Name="Macrofy logo" Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>
                    <local:LogoMark x:Name="Logo" Width="92" Height="92" RenderTransformOrigin="0.5,0.5">
                        <local:LogoMark.RenderTransform><ScaleTransform /></local:LogoMark.RenderTransform>
                    </local:LogoMark>
                </Button>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Macrofy" FontSize="36" FontWeight="SemiBold" />
                    <TextBlock x:Name="Tagline" FontSize="16" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,34,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- Left: how it works, in plain words, plus a picture of it -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionLabel}" />
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Windows tells apps which keyboard every key press came from. Macrofy listens for the one you captured, stops its keys from typing, and runs your macro instead. Every other keyboard is left alone, and there's no driver to install." />

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource DiagramKey}">
                                    <TextBlock Text="Main keyboard" FontSize="12.5" FontWeight="SemiBold" />
                                </Border>
                                <Path Style="{StaticResource Arrow}" />
                                <TextBlock Text="types like normal" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Style="{StaticResource DiagramKey}" Background="{DynamicResource RmAccentMutedBrush}"
                                        BorderBrush="{DynamicResource RmAccentBrush}">
                                    <TextBlock Text="Macro keyboard" FontSize="12.5" FontWeight="SemiBold" />
                                </Border>
                                <Path Style="{StaticResource Arrow}" />
                                <local:LogoMark Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="Macrofy" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                                <Path Style="{StaticResource Arrow}" />
                                <TextBlock Text="runs your macro" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SAY HI" Style="{StaticResource SectionLabel}" Margin="0,28,0,0" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,8,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Found a bug, or got an idea for a macro it can't do yet? It all lives on GitHub." />
                    <WrapPanel>
                        <ui:Button Content="Source code" Icon="{ui:SymbolIcon Code24}" Click="OpenRepo_Click" Margin="0,0,8,8" />
                        <ui:Button Content="Report a problem" Icon="{ui:SymbolIcon Bug24}" Click="ReportProblem_Click" Margin="0,0,8,8" />
                        <ui:Button Content="What's new" Icon="{ui:SymbolIcon News24}" Click="ReleaseNotes_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>

                <!-- Right: the spec sheet, like the back of the box -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="0" Text="Price" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Free, every macro feature" Style="{StaticResource SpecValue}" />

                            <Border Grid.Row="1" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="1" Text="Driver" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="None needed" Style="{StaticResource SpecValue}" />

                            <Border Grid.Row="2" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="2" Text="Goes online" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Only to check GitHub for updates" Style="{StaticResource SpecValue}" />

                            <Border Grid.Row="3" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="3" Text="Your stuff" Style="{StaticResource SpecLabel}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,9,0,9">
                                <TextBlock x:Name="DataPath" FontSize="12.5" TextWrapping="Wrap" />
                                <Button Content="Open folder" Style="{StaticResource TextLink}" FontSize="12"
                                        HorizontalAlignment="Left" Margin="0,3,0,0" Click="OpenData_Click" />
                            </StackPanel>

                            <Border Grid.Row="4" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="4" Text="Licence" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Open source (MIT)" Style="{StaticResource SpecValue}" />

                            <Border Grid.Row="5" Style="{StaticResource SpecRule}" />
                            <TextBlock Grid.Row="5" Text="Built with" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text=".NET 8, WPF-UI and Velopack" Style="{StaticResource SpecValue}" />

                            <TextBlock Grid.Row="6" Text="Version" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource SpecValue}" />
                        </Grid>
                    </Border>

                    <!-- Updates, right under the version -->
                    <StackPanel Margin="4,14,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}">
                            <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}" Click="CheckUpdates_Click" />
                            <ui:Button Content="Install update" Appearance="Primary" Margin="8,0,0,0" Click="InstallUpdate_Click"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Margin="2,36,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="made for windows :D" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
