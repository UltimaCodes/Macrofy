<UserControl x:Class="Macrofy.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Macrofy.App">
    <UserControl.Resources>
        <Style x:Key="Feature" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.Enabled="True">
        <StackPanel Margin="28,22,28,28" MaxWidth="720" HorizontalAlignment="Left">
            <Grid Margin="0,4,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:LogoMark Grid.Column="0" Width="64" Height="64" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Macrofy" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}  ·  driver-free macro pad for Windows'}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,0,0,22"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Take a spare keyboard and turn it into a macro pad, without touching the keyboard you type on. Every macro feature is free." />

            <Border Style="{StaticResource Feature}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top" Background="{DynamicResource RmAccentMutedBrush}">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="22" Foreground="{DynamicResource RmAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="One keyboard, fully yours" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Macrofy takes over one keyboard so its keys stop typing and start running macros. Your other keyboards keep working as normal." />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Feature}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top" Background="{DynamicResource RmAccentMutedBrush}">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="22" Foreground="{DynamicResource RmAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="An action for everything" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Open apps and links, type text, send shortcuts, control music, run commands. One action per key, or a whole sequence." />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Feature}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top" Background="{DynamicResource RmAccentMutedBrush}">
                        <ui:SymbolIcon Symbol="Album24" FontSize="22" Foreground="{DynamicResource RmAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Profiles, layers and templates" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Save sets of macros and switch between them, hold a key for a second layer, or start from the OBS, Photoshop and VS Code templates." />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Feature}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top" Background="{DynamicResource RmAccentMutedBrush}">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="22" Foreground="{DynamicResource RmAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Driver-free, and nothing leaves your PC" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="No kernel driver. The keyboard hook loads only while you capture a keyboard. Your macros stay in your AppData folder." />
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Margin="0,10,0,0">
                <ui:Button Content="Website and source code" Icon="{ui:SymbolIcon Globe24}" Click="OpenRepo_Click" Margin="0,0,8,8" />
                <ui:Button Content="Report a problem" Icon="{ui:SymbolIcon Warning24}" Click="ReportProblem_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Margin="2,12,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="made for windows :D" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
