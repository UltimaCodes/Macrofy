<ui:FluentWindow x:Class="Macrofy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Macrofy.App"
        xmlns:views="clr-namespace:Macrofy.App.Views"
        Title="Macrofy"
        Height="840" Width="1260" MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource RmWindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Macrofy" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource RmSidebarBrush}" CornerRadius="14" Margin="8,0,4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,18,24">
                        <local:LogoMark Width="34" Height="34" />
                        <TextBlock Text="Macrofy" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,16,18">
                        <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource RmSubtleBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource RmAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasHookIssue}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource RmWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding CaptureStateText, StringFormat='Capture: {0}'}" />
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding AppVersion, StringFormat='v{0}'}" />
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavKeyboards" AutomationProperties.Name="Keyboards" GroupName="Nav" Style="{StaticResource NavItemStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" />
                                <TextBlock Text="Keyboards" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProfiles" AutomationProperties.Name="Profiles" GroupName="Nav" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Album24" FontSize="18" />
                                <TextBlock Text="Profiles" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" AutomationProperties.Name="Settings" GroupName="Nav" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" AutomationProperties.Name="About" GroupName="Nav" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                                <TextBlock Text="About" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Border Grid.Column="1" Background="{DynamicResource RmPanelBrush}" CornerRadius="14" Margin="4,0,8,0">
                <Grid>
                    <views:KeyboardsView local:Anim.FadeInOnVisible="True"
                                         Visibility="{Binding IsChecked, ElementName=NavKeyboards, Converter={StaticResource BoolToVis}}" />
                    <views:ProfilesView local:Anim.FadeInOnVisible="True"
                                        Visibility="{Binding IsChecked, ElementName=NavProfiles, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView local:Anim.FadeInOnVisible="True"
                                        Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}" />
                    <views:AboutView local:Anim.FadeInOnVisible="True"
                                     Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Confirmation toasts -->
        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.RowSpan="2" Margin="0,0,0,24" />
    </Grid>
</ui:FluentWindow>
