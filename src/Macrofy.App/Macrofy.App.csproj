<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Macrofy.Core\Macrofy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- The hook DLL ships beside the exe (publish.ps1), with an embedded copy in Macrofy.Core as
       a fallback. Tray/title-bar icons come from the exe's own ApplicationIcon. -->

  <!-- Shown in the exe's Properties > Details, and weighed by SmartScreen/AV: a blank publisher
       reads as more suspicious. -->
  <PropertyGroup>
    <Product>Macrofy</Product>
    <AssemblyTitle>Macrofy</AssemblyTitle>
    <Company>Ryaan Aaqil</Company>
    <Authors>Ryaan Aaqil</Authors>
    <Description>Turn a spare keyboard into a macro pad on Windows.</Description>
    <Copyright>Copyright © Ryaan Aaqil</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- WinForms is enabled only for its NotifyIcon (system tray). Drop its implicit usings so
       its types don't collide with WPF's (Application, MessageBox, etc.); we fully-qualify the
       handful of WinForms types we use. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\macrofy.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
