<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Macrofy.Core\Macrofy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Velopack has to run before WPF starts (it handles install/update/uninstall hooks), so
       App.xaml is a plain page and Program.Main starts the app instead of a generated Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- The hook DLL ships beside the exe; Macrofy.Core also embeds a copy as a fallback. -->
  <ItemGroup>
    <None Include="..\..\native\MacrofyHook.dll" Link="MacrofyHook.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shown in the exe's Properties > Details, and weighed by SmartScreen/AV: a blank publisher
       reads as more suspicious. -->
  <PropertyGroup>
    <Product>Macrofy</Product>
    <AssemblyTitle>Macrofy</AssemblyTitle>
    <Company>Macrofy</Company>
    <Authors>Macrofy</Authors>
    <Description>Turn a spare keyboard into a macro pad on Windows.</Description>
    <Copyright>Copyright © Macrofy</Copyright>
    <Version>1.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- WinForms is enabled only for its NotifyIcon (system tray). Drop its implicit usings so
       its types don't collide with WPF's (Application, MessageBox, etc.); we fully-qualify the
       handful of WinForms types we use. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Macrofy</AssemblyName>
    <RootNamespace>Macrofy.App</RootNamespace>
    <StartupObject>Macrofy.App.Program</StartupObject>
    <ApplicationIcon>Assets\macrofy.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
