<ui:FluentWindow x:Class="Macrofy.App.FirstRunKeyHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Heads-up"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{DynamicResource RmWindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Heads-up" />

        <StackPanel Grid.Row="1" Margin="24,6,24,22">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource RmAccentMutedBrush}">
                    <ui:SymbolIcon Symbol="Info24" FontSize="22" Foreground="{DynamicResource RmAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="A few things to know" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="The left and right Windows keys (the ⊞ keys next to Ctrl and Alt) can't be macros. Windows acts on them before Macrofy sees them, so they show up dimmed. Every other key works, including Ctrl, Alt, Shift and the menu key." />
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Capture stops the keyboard typing in normal apps. Some apps read keyboards directly though, including a lot of games, Discord push-to-talk and OBS hotkeys, and those still see its keys. Microsoft Store apps (like Calculator) and apps running as administrator aren't covered either, unless you run Macrofy as administrator for the second one. Macrofy tells you when it notices this happening." />

            <ui:CardExpander Margin="0,16,0,0">
                <ui:CardExpander.Header>
                    <TextBlock Text="Why these limits?" FontWeight="SemiBold" />
                </ui:CardExpander.Header>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Macrofy works out which keyboard a key came from using Raw Input, then a small hook in each app decides whether to let the key through. Anything that happens before that hook (the Windows keys, apps reading Raw Input themselves) or where Windows won't run it (Store apps) can't be blocked without a kernel driver, which Macrofy deliberately doesn't install." />
            </ui:CardExpander>

            <ui:Button Margin="0,18,0,0" HorizontalAlignment="Right" Appearance="Primary"
                       Content="Got it" Click="Ok_Click" MinWidth="96" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
